{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orcafacil",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  "assets": {
    "directory": ".output/public"
  },
  "observability": {
    "enabled": true
  }
}
